diff --git a/gaze/gazecal.py b/gaze/gazecal.py
index f261ba3..902d35b 100644
--- a/gaze/gazecal.py
+++ b/gaze/gazecal.py
@@ -7,6 +7,7 @@ the tracker has lost the other), EyeWeights (how much each eye counts), and Stea
 reports them.
 """
 
+import enum
 import math
 import os
 import statistics
@@ -15,6 +16,25 @@ from pathlib import Path
 
 STATE = Path.home() / ".local" / "state" / "frametop" / "gaze"
 
+
+# --- Where gaze/build's programs run ------------------------------------------------
+
+class Builds(enum.Enum):
+    CONTAINER = "0"  # built in the dev container (gaze/build.sh), so run there
+    HOST = "1"       # built for the host (frametop-nix)
+
+
+# FRAMETOP_HOST_BUILDS=1: gaze/build's programs (ft-gaze, ft-gazepanel) run on the host.
+BUILDS = Builds(os.environ.get("FRAMETOP_HOST_BUILDS", "0"))
+
+
+def build_argv(prog, *args, where=BUILDS):
+    """The command that runs one of gaze/build's programs where it was built."""
+    argv = [str(prog), *args]
+    if where == Builds.HOST:
+        return argv
+    return [str(Path.home() / ".local" / "bin" / "distrobox"), "enter", "dev", "--", *argv]
+
 # --- Small math ---------------------------------------------------------------------
 
 def px_from_deg(j, dy, dp):
