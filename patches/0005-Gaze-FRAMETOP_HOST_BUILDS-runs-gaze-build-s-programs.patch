diff --git a/gaze/test_gazecal_builds.py b/gaze/test_gazecal_builds.py
new file mode 100644
index 0000000..df242a3
--- /dev/null
+++ b/gaze/test_gazecal_builds.py
@@ -0,0 +1,19 @@
+"""Tests for gazecal.build_argv. Run: python3 -m pytest gaze/ (needs pytest and hypothesis)."""
+from hypothesis import given, strategies as st
+
+import gazecal
+
+PROG = "/home/steamos/frametop/gaze/build/ft-gaze"
+ARGS = st.lists(st.text(min_size=1), max_size=4)
+
+
+@given(ARGS)
+def test_host_runs_prog(args):
+    assert gazecal.build_argv(PROG, *args, where=gazecal.Builds.HOST) == [PROG, *args]
+
+
+@given(ARGS)
+def test_container_wraps_prog(args):
+    argv = gazecal.build_argv(PROG, *args, where=gazecal.Builds.CONTAINER)
+    assert argv[0].endswith("/distrobox") and argv[1:4] == ["enter", "dev", "--"]
+    assert argv[4:] == [PROG, *args]
