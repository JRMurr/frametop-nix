--- /dev/null
+++ b/hands/tests/test_cutouts.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Tests for hands/ft-cutouts: where it runs ft-hands. Runs a copy of it with fake systemctl,
+systemd-run, getcap, and journalctl on PATH, so nothing reaches systemd or SteamVR.
+
+  python3 hands/tests/test_cutouts.py
+"""
+import os
+import shutil
+import subprocess
+import tempfile
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+CUTOUTS = os.path.join(os.path.dirname(HERE), "ft-cutouts")
+BASH = shutil.which("bash")  # not /usr/bin/env, which a build sandbox doesn't have
+
+FAKES = {
+    # SteamVR runs; no unit of ours does yet.
+    "systemctl": '[ "$2" = show ] && exit 0; for a; do [ "$a" = steamvr.service ] && exit 0; done; exit 1',
+    "getcap": 'echo "$1 cap_sys_ptrace,cap_perfmon,cap_dac_read_search=ep"',
+    "systemd-run": 'printf "%s\\n" "$*" >> "$RUNS"',
+    "journalctl": "true",
+    "pkill": "true",
+    "sleep": "true",
+}
+
+
+class CutoutsTest(unittest.TestCase):
+    def runs(self, host_builds):
+        """The systemd-run command lines of `ft-cutouts on`."""
+        with tempfile.TemporaryDirectory() as tmp:
+            bindir, hands = os.path.join(tmp, "bin"), os.path.join(tmp, "repo", "hands")
+            for d in (bindir, os.path.join(hands, "build"), os.path.join(tmp, "repo", "scripts")):
+                os.makedirs(d)
+            for name, body in FAKES.items():
+                self.script(os.path.join(bindir, name), body)
+            self.script(os.path.join(hands, "build", "ft-camd"), "true")
+            self.script(os.path.join(hands, "build", "ft-hands"), "true  # --no-gestures")
+            self.script(os.path.join(hands, "ft-handsctl"), "true")
+            self.script(os.path.join(tmp, "repo", "scripts", "container-up.sh"), "true")
+            with open(CUTOUTS) as src, open(os.path.join(hands, "ft-cutouts"), "w") as dst:
+                dst.write(f"#!{BASH}\n" + src.read().split("\n", 1)[1])
+            os.chmod(os.path.join(hands, "ft-cutouts"), 0o755)
+
+            env = dict(os.environ, PATH=f"{bindir}:{os.environ['PATH']}", RUNS=os.path.join(tmp, "runs"),
+                       HOME=tmp, FRAMETOP_HOST_BUILDS=host_builds)
+            subprocess.run([os.path.join(hands, "ft-cutouts"), "on"], env=env, check=True,
+                           stdout=subprocess.DEVNULL)
+            with open(env["RUNS"]) as f:
+                return f.read().splitlines()
+
+    @staticmethod
+    def script(path, body):
+        with open(path, "w") as f:
+            f.write(f"#!{BASH}\n{body}\n")
+        os.chmod(path, 0o755)
+
+    def hands_run(self, runs):
+        return next(r for r in runs if "frametop-cutouts-hands" in r)
+
+    def test_host_runs_ft_hands(self):
+        run = self.hands_run(self.runs("1"))
+        self.assertNotIn("distrobox", run)
+        self.assertIn("/build/ft-hands --status 60 --no-gestures", run)
+
+    def test_container_runs_ft_hands_there(self):
+        run = self.hands_run(self.runs("0"))
+        self.assertIn("distrobox enter dev --", run)
+
+
+if __name__ == "__main__":
+    unittest.main()
