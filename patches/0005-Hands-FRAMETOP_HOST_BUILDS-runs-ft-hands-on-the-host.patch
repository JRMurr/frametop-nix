diff --git a/hands/rec/tests/test_tracker_argv.py b/hands/rec/tests/test_tracker_argv.py
new file mode 100644
index 0000000..f2b0467
--- /dev/null
+++ b/hands/rec/tests/test_tracker_argv.py
@@ -0,0 +1,33 @@
+#!/usr/bin/env python3
+"""Tests for session.tracker_argv: where the recorder runs ft-hands.
+
+  python3 hands/rec/tests/test_tracker_argv.py
+"""
+import os
+import sys
+import unittest
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, os.path.dirname(HERE))
+import session  # noqa: E402
+
+ARGV = [session.FT_HANDS, "--no-gestures", "--status", "0"]
+
+
+class TrackerArgvTest(unittest.TestCase):
+    def test_host_builds_run_directly(self):
+        for place in session.Place:
+            self.assertEqual(session.tracker_argv(ARGV, session.Builds.HOST, place), ARGV)
+
+    def test_container_builds_from_the_host_enter_it(self):
+        argv = session.tracker_argv(ARGV, session.Builds.CONTAINER, session.Place.HOST)
+        self.assertTrue(argv[0].endswith("/distrobox"))
+        self.assertEqual(argv[1:4], ["enter", "dev", "--"])
+        self.assertEqual(argv[4:], ARGV)
+
+    def test_container_builds_in_the_container_run_directly(self):
+        self.assertEqual(session.tracker_argv(ARGV, session.Builds.CONTAINER, session.Place.CONTAINER), ARGV)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/hands/tests/test_cutouts.py b/hands/tests/test_cutouts.py
