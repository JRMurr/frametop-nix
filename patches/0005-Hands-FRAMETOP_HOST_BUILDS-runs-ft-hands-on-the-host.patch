+class Builds(enum.Enum):
+    CONTAINER = "0"  # hands/build is built in the dev container (hands/build.sh)
+    HOST = "1"       # built for the host (frametop-nix)
+
+
+class Place(enum.Enum):
+    CONTAINER = "container"
+    HOST = "host"
+
+
+# FRAMETOP_HOST_BUILDS=1: hands/build's ft-hands runs on the host.
+BUILDS = Builds(os.environ.get("FRAMETOP_HOST_BUILDS", "0"))
+
+
+def here():
+    return Place.CONTAINER if in_container() else Place.HOST
+
+
+def tracker_argv(argv, builds, place):
+    """argv for ft-hands, started from place: in the dev container unless it's built for the host."""
+    if builds == Builds.HOST or place == Place.CONTAINER:
+        return list(argv)
+    return [os.path.expanduser("~/.local/bin/distrobox"), "enter", "dev", "--"] + list(argv)
+
